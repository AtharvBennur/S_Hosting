APP_NAME=MPLADS AI Monitoring
APP_ENV=production
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
UPLOAD_DIR=./uploads
RETAIN_UPLOADED_FILES=false
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_ROWS=1000000
MAX_UPLOAD_COLUMNS=500
CORS_ALLOWED_ORIGINS=http://13.48.137.1:4173,http://localhost:4173,http://127.0.0.1:4173
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=5
GENERAL_RATE_LIMIT_PER_MINUTE=60
EXPENSIVE_RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_MB=5
# Keep false until HTTPS is configured for the public IP/domain.
HSTS_ENABLED=false
PII_SCAN_ENABLED=true
PII_SAMPLE_SIZE=1000
PII_MASKING_ENABLED=true
SECURITY_SCAN_ENABLED=true
SECURITY_MONITORING_ENABLED=true
SECURITY_ALERT_DEDUP_WINDOW_SECONDS=300
MODEL_DIR=./trained_models
# Replace this before any non-demo or internet-facing production use.
AUTH_SECRET=replace-this-with-a-long-random-secret
AUTH_TOKEN_MINUTES=30
AUTH_ALLOWED_EMAIL_DOMAINS=gov.in,nic.in
# Same clearly fake demo credential requested for this deployment.
AUTH_DEMO_PASSWORD=Demo@123
STATE_CAN_PROVISION_USERS=true
# Generate a value with the command documented in backend/.env.example.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=v1
APP_ENCRYPTION_KEYS=
